# Local Docker leaves the host and port as written. GEMINI_API_KEY is optional.
# Without it the clerk uses the payload sentence.
GEMINI_API_KEY=
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379

# FalkorDB Cloud, from the instance Connectivity and Instance Details tabs.
# Free instances leave FALKORDB_TLS empty. Paid instances with TLS set it to true.
# FALKORDB_URL=falkor://falkordb:password@host:port
# FALKORDB_USERNAME=falkordb
# FALKORDB_PASSWORD=
# FALKORDB_TLS=
